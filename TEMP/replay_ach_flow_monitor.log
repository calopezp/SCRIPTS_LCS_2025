67.0 APEX_CODE,DEBUG;APEX_PROFILING,INFO
Execute Anonymous: // SOLO LECTURA -- reproduce la misma logica de SM_ACH_Flow_Monitor.runDailyCheck()
Execute Anonymous: // sin mandar correo, para ver que reportaria ahora mismo (y comparar con el correo real de hoy).
Execute Anonymous: DateTime since = DateTime.now().addHours(-24);
Execute Anonymous: 
Execute Anonymous: List<Contract> activatedToday = [
Execute Anonymous:     SELECT Id, ContractNumber, Status, SM_Payment_methods__c, CB_Subscription__c,
Execute Anonymous:            SM_AC_collected__c, SM_Net_AC__c, SM_Net_Monthly_offer__c, StartDate,
Execute Anonymous:            (SELECT Id, SM_Payment_Type__c FROM ACH_Orders__r WHERE SM_Payment_Type__c = 'Subscription')
Execute Anonymous:     FROM Contract
Execute Anonymous:     WHERE Status = 'Activated' AND StartDate = TODAY
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: List<Contract> recentContracts = [
Execute Anonymous:     SELECT Id, ContractNumber, Status, SM_Requires_AC_Payment__c, SM_Requires_RC_Payment__c,
Execute Anonymous:            SM_AC_collected__c, SM_Payment_methods__c, CB_Subscription__c,
Execute Anonymous:            Is_Test_Contract__c, Is_VIP_Contract__c, SM_Customer_Cancellation__c,
Execute Anonymous:            Contract_Type__c, SM_Full_Payment__c, SM_Total_ac__c, SM_AC_start_date__c,
Execute Anonymous:            SM_AC_Split_Date__c
Execute Anonymous:     FROM Contract
Execute Anonymous:     WHERE SM_Payment_methods__c = 'ACH'
Execute Anonymous:       AND Status IN ('Payment Process', 'Activated')
Execute Anonymous:       AND (LastModifiedDate >= :since OR CreatedDate >= :since)
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: Set<Id> contractIds = new Set<Id>();
Execute Anonymous: for (Contract c : recentContracts) { contractIds.add(c.Id); }
Execute Anonymous: 
Execute Anonymous: Integer newOrdersCount = [SELECT COUNT() FROM SM_ACH_Order__c WHERE CreatedDate >= :since];
Execute Anonymous: 
Execute Anonymous: List<SM_ACH_Order__c> activeOrders = contractIds.isEmpty() ? new List<SM_ACH_Order__c>() : [
Execute Anonymous:     SELECT Id, SM_Contract__c, SM_Payment_Type__c
Execute Anonymous:     FROM SM_ACH_Order__c
Execute Anonymous:     WHERE SM_Contract__c IN :contractIds
Execute Anonymous:     AND SM_Payment_Status__c NOT IN ('Completed', 'Canceled')
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: List<String> anomalies = SM_ACH_Flow_Monitor.buildAnomalies(recentContracts, activeOrders);
Execute Anonymous: for (Contract c : activatedToday) {
Execute Anonymous:     if (c.SM_Payment_methods__c == 'ACH' && c.ACH_Orders__r.isEmpty()) {
Execute Anonymous:         anomalies.add('ALERTA: Contrato ' + c.ContractNumber + ' se activo por ACH pero no tiene Subscription Order');
Execute Anonymous:     }
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: System.debug('Contratos activados HOY (cualquier medio de pago): ' + activatedToday.size());
Execute Anonymous: for (Contract c : activatedToday) {
Execute Anonymous:     System.debug('  - ' + c.ContractNumber + ' (' + c.SM_Payment_methods__c + ')');
Execute Anonymous: }
Execute Anonymous: System.debug('Contratos ACH en Payment Process/Activated, tocados ult. 24h: ' + recentContracts.size());
Execute Anonymous: System.debug('SM_ACH_Order__c nuevas ultimas 24h: ' + newOrdersCount);
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: System.debug('ANOMALIAS (' + anomalies.size() + '):');
Execute Anonymous: for (String a : anomalies) {
Execute Anonymous:     System.debug('  - ' + a);
Execute Anonymous: }
Execute Anonymous: System.debug('=======================================================');
