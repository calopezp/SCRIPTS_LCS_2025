Execute Anonymous: /*
Execute Anonymous:  * fix_stuck_cancelled_contracts.apex
Execute Anonymous:  * ------------------------------------
Execute Anonymous:  * Hallazgo 2026-09-16: al correr mark_transmitted_accepted.apex, 200/227
Execute Anonymous:  * pagos fallaron en una sola oleada -- pero la causa real es UNA orden ACH
Execute Anonymous:  * (ACH-28209) cuyo contrato ya esta Cancelled. Cuando un pago de esa orden
Execute Anonymous:  * pasa a ACCEPTED, SM_PaymentHandler.updateRelatedRecordsByPaymentStatusUpdates()
Execute Anonymous:  * (linea 269) intenta forzar la orden a 'Canceled', pero
Execute Anonymous:  * SM_ACHOrderHandler.validateCanceledStatus() (linea 530) bloquea con
Execute Anonymous:  * addError() porque la orden todavia tiene un pago hermano en
Execute Anonymous:  * ACH_PENDING/ACH_TRANSMITTED -- y como SM_PaymentHandler usa
Execute Anonymous:  * Database.update(achOrdersToUpdate) SIN allOrNone=false (linea 294), UNA
Execute Anonymous:  * orden bloqueada tumba TODO el batch de ordenes de esa transaccion, lo que
Execute Anonymous:  * arrastra como fallidos a los demas 199 pagos de la misma oleada (aunque
Execute Anonymous:  * no tengan nada que ver).
Execute Anonymous:  *
Execute Anonymous:  * Barrido completo del org (2026-09-16): exactamente 11 pagos en 10 ordenes
Execute Anonymous:  * ACH distintas, todos en contratos ya Cancelled, siguen en ACH TRANSMITTED
Execute Anonymous:  * sin ningun reporte -- son el 100% de los pagos "atascados" de este tipo
Execute Anonymous:  * en todo el org (no solo del batch que fallo hoy).
Execute Anonymous:  *
Execute Anonymous:  * SOLUCION EN 2 PASOS (instruccion explicita del usuario 2026-09-16):
Execute Anonymous:  *   Paso A: marcar los 11 pagos como ACCEPTED/COLLECTED (misma regla de 15
Execute Anonymous:  *           dias que el resto), con SM_TriggerHandler.avoidAllHandlerExcecution
Execute Anonymous:  *           = true para que NO dispare el intento de cancelar la orden
Execute Anonymous:  *           dentro de esta misma transaccion (evita el choque).
Execute Anonymous:  *   Paso B: con los handlers YA reactivados (bypass = false), actualizar
Execute Anonymous:  *           las 10 ordenes ACH a SM_Payment_Status__c = 'Completed' -- una
Execute Anonymous:  *           vez que ningun pago hermano sigue ACH_PENDING/ACH_TRANSMITTED
Execute Anonymous:  *           (verificado antes de escribir), la validacion de
Execute Anonymous:  *           validateCanceledStatus() ni siquiera aplica (esa solo bloquea el
Execute Anonymous:  *           cambio a 'Canceled', no a 'Completed'), asi que el resto de la
Execute Anonymous:  *           automatizacion normal de la orden corre igual que cualquier
Execute Anonymous:  *           actualizacion real.
Execute Anonymous:  *
Execute Anonymous:  *           NOTA -- correccion del usuario 2026-09-16: el codigo actual de
Execute Anonymous:  *           SM_PaymentHandler.cls (lineas 264-289) manda la orden a
Execute Anonymous:  *           'Canceled' tanto si el ultimo pago fue ACCEPTED como REJECTED,
Execute Anonymous:  *           con tal de que el contrato este Cancelled -- no distingue. Eso
Execute Anonymous:  *           es inconsistente: si el pago SI se cobro (ACCEPTED), la orden
Execute Anonymous:  *           cumplio su proposito y deberia quedar 'Completed' (igual que
Execute Anonymous:  *           pasa con un contrato Finalized), no 'Canceled'. 'Canceled' tiene
Execute Anonymous:  *           sentido solo si el pago fallo (REJECTED) con el contrato ya
Execute Anonymous:  *           cancelado. Este script sigue la logica corregida; el bug en
Execute Anonymous:  *           SM_PaymentHandler.cls en si no se toca aqui.
Execute Anonymous:  *
Execute Anonymous:  * Corre primero con DRY_RUN = true -> solo preview, NO actualiza nada.
Execute Anonymous:  */
Execute Anonymous: 
Execute Anonymous: Boolean DRY_RUN = true; // <-- cambiar a false SOLO con autorizacion explicita del usuario
Execute Anonymous: 
Execute Anonymous: Set<String> paymentNames = new Set<String>{
Execute Anonymous:     'PY-01889016', 'PY-01888782', 'PY-01889163', 'PY-01895389',
Execute Anonymous:     'PY-01888832', 'PY-01888809', 'PY-01888816', 'PY-01895410',
Execute Anonymous:     'PY-01895456', 'PY-01895464', 'PY-01895482'
Execute Anonymous: };
Execute Anonymous: 
Execute Anonymous: List<SM_Payment__c> payments = [
Execute Anonymous:     SELECT Id, Name, Payment_Status__c, SM_Check_Collection_Status__c,
Execute Anonymous:            SM_Historical_Collection_Status__c, SM_ACH_Order__c,
Execute Anonymous:            SM_ACH_Order__r.Name, SM_ACH_Order__r.SM_Payment_Status__c,
Execute Anonymous:            SM_Contract__r.ContractNumber, SM_Contract__r.Status
Execute Anonymous:     FROM SM_Payment__c
Execute Anonymous:     WHERE Name IN :paymentNames
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: System.debug(' -> MODO: ' + (DRY_RUN ? 'DRY RUN (solo preview, sin cambios)' : 'EJECUCION REAL'));
Execute Anonymous: System.debug(' -> Pagos encontrados: ' + payments.size() + ' / ' + paymentNames.size());
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: 
Execute Anonymous: Set<Id> achOrderIds = new Set<Id>();
Execute Anonymous: Date today = Date.today();
Execute Anonymous: List<SM_Payment__c> paymentUpdates = new List<SM_Payment__c>();
Execute Anonymous: 
Execute Anonymous: for (SM_Payment__c p : payments) {
Execute Anonymous:     achOrderIds.add(p.SM_ACH_Order__c);
Execute Anonymous: 
Execute Anonymous:     String tag = 'PRC_AUT_FIX_CANCELLED_CONTRACT_ORDER: ACCEPTED //';
Execute Anonymous:     String previous = p.SM_Historical_Collection_Status__c == null ? '' : p.SM_Historical_Collection_Status__c;
Execute Anonymous:     String newHistorical = tag + previous;
Execute Anonymous:     if (newHistorical.length() > 150) {
Execute Anonymous:         newHistorical = newHistorical.substring(0, 150);
Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     System.debug('---------------------------------------------------------');
Execute Anonymous:     System.debug(p.Name + '  (Orden ' + p.SM_ACH_Order__r.Name + ', Contrato ' +
Execute Anonymous:             p.SM_Contract__r.ContractNumber + ' / ' + p.SM_Contract__r.Status + ')');
Execute Anonymous:     System.debug('  PAGO ACTUAL -> Payment_Status=' + p.Payment_Status__c +
Execute Anonymous:             ' | Collection_Status=' + p.SM_Check_Collection_Status__c);
Execute Anonymous:     System.debug('  PAGO NUEVO  -> Payment_Status=ACCEPTED | Collection_Status=COLLECTED');
Execute Anonymous:     System.debug('  Historico nuevo -> ' + newHistorical);
Execute Anonymous: 
Execute Anonymous:     paymentUpdates.add(new SM_Payment__c(
Execute Anonymous:             Id = p.Id,
Execute Anonymous:             Payment_Status__c = 'ACCEPTED',
Execute Anonymous:             SM_Check_Collection_Date__c = today,
Execute Anonymous:             SM_Check_Collection__c = true,
Execute Anonymous:             SM_Check_Collection_Status__c = 'COLLECTED',
Execute Anonymous:             SM_Historical_Collection_Status__c = newHistorical
Execute Anonymous:     ));
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: List<SM_ACH_Order__c> orders = [
Execute Anonymous:     SELECT Id, Name, SM_Payment_Status__c
Execute Anonymous:     FROM SM_ACH_Order__c
Execute Anonymous:     WHERE Id IN :achOrderIds
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: System.debug(' -> Ordenes ACH involucradas: ' + orders.size());
Execute Anonymous: for (SM_ACH_Order__c o : orders) {
Execute Anonymous:     System.debug('  ' + o.Name + ' -> ACTUAL: ' + o.SM_Payment_Status__c + ' | NUEVO: Completed');
Execute Anonymous: }
Execute Anonymous: System.debug('=======================================================');
Execute Anonymous: 
Execute Anonymous: if (!DRY_RUN) {
Execute Anonymous:     // Paso A: pagos, CON bypass de handlers (evita el choque en la misma transaccion)
Execute Anonymous:     SM_TriggerHandler.avoidAllHandlerExcecution = true;
Execute Anonymous:     Database.SaveResult[] paymentResults = Database.update(paymentUpdates, false);
Execute Anonymous:     Integer okP = 0, errP = 0;
Execute Anonymous:     for (Database.SaveResult sr : paymentResults) {
Execute Anonymous:         if (sr.isSuccess()) {
Execute Anonymous:             okP++;
Execute Anonymous:         } else {
Execute Anonymous:             errP++;
Execute Anonymous:             System.debug(' -> ERROR actualizando pago ' + sr.getId() + ': ' + sr.getErrors());
Execute Anonymous:         }
Execute Anonymous:     }
Execute Anonymous:     System.debug(' -> Paso A (pagos) -> Exitos: ' + okP + ' | Errores: ' + errP);
Execute Anonymous:     SM_TriggerHandler.avoidAllHandlerExcecution = false;
Execute Anonymous: 
Execute Anonymous:     // Paso B: verificar que ya no queda ningun pago hermano pendiente, y
Execute Anonymous:     // SOLO entonces cancelar la orden -- SIN bypass, para que corra la
Execute Anonymous:     // automatizacion normal de una cancelacion real.
Execute Anonymous:     Map<Id, Integer> pendingSiblingsByOrder = new Map<Id, Integer>();
Execute Anonymous:     for (SM_Payment__c sib : [
Execute Anonymous:             SELECT SM_ACH_Order__c
Execute Anonymous:             FROM SM_Payment__c
Execute Anonymous:             WHERE SM_ACH_Order__c IN :achOrderIds
Execute Anonymous:               AND Payment_Status__c IN ('ACH PENDING', 'ACH TRANSMITTED')
Execute Anonymous:     ]) {
Execute Anonymous:         Integer c = pendingSiblingsByOrder.containsKey(sib.SM_ACH_Order__c) ? pendingSiblingsByOrder.get(sib.SM_ACH_Order__c) : 0;
Execute Anonymous:         pendingSiblingsByOrder.put(sib.SM_ACH_Order__c, c + 1);
Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     List<SM_ACH_Order__c> orderUpdates = new List<SM_ACH_Order__c>();
Execute Anonymous:     for (SM_ACH_Order__c o : orders) {
Execute Anonymous:         if (pendingSiblingsByOrder.containsKey(o.Id)) {
Execute Anonymous:             System.debug(' -> SALTANDO ' + o.Name + ': todavia tiene ' + pendingSiblingsByOrder.get(o.Id) + ' pago(s) pendiente(s) -- no se actualiza.');
Execute Anonymous:             continue;
Execute Anonymous:         }
Execute Anonymous:         if (o.SM_Payment_Status__c == 'Completed') {
Execute Anonymous:             System.debug(' -> SALTANDO ' + o.Name + ': ya esta Completed, no hace falta tocarla.');
Execute Anonymous:             continue;
Execute Anonymous:         }
Execute Anonymous:         orderUpdates.add(new SM_ACH_Order__c(Id = o.Id, SM_Payment_Status__c = 'Completed'));
Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     Integer okO = 0, errO = 0;
Execute Anonymous:     if (!orderUpdates.isEmpty()) {
Execute Anonymous:         Database.SaveResult[] orderResults = Database.update(orderUpdates, false);
Execute Anonymous:         for (Database.SaveResult sr : orderResults) {
Execute Anonymous:             if (sr.isSuccess()) {
Execute Anonymous:                 okO++;
Execute Anonymous:             } else {
Execute Anonymous:                 errO++;
Execute Anonymous:                 System.debug(' -> ERROR actualizando orden ' + sr.getId() + ': ' + sr.getErrors());
Execute Anonymous:             }
Execute Anonymous:         }
Execute Anonymous:     }
Execute Anonymous:     System.debug(' -> Paso B (ordenes) -> Exitos: ' + okO + ' | Errores: ' + errO + ' | Saltadas: ' + (orders.size() - orderUpdates.size()));
Execute Anonymous: } else {
Execute Anonymous:     System.debug(' -> DRY RUN: no se realizo ningun cambio. Cambiar DRY_RUN a false para ejecutar.');
Execute Anonymous: }
