Execute Anonymous: Set<Id> invoicesEmparejadas = new Set<Id>();
Execute Anonymous: List<PlanLPF> planesLPF = new List<PlanLPF>();
Execute Anonymous: 
Execute Anonymous: // 4a. Recorrer los invoices HIJOS (multa) pendientes y buscar su padre.
Execute Anonymous: for (chargebeeapps__CB_Invoice__c hijo : pendientes) {
Execute Anonymous:     if (hijo.Parent_CB_Invoice__c == null) continue; // no es un hijo de Late Fee
Execute Anonymous: 
Execute Anonymous:     chargebeeapps__CB_Invoice__c padre = invoicesById.get(hijo.Parent_CB_Invoice__c);
Execute Anonymous:     Decimal dueMulta = (hijo.chargebeeapps__Due_Amount__c != null) ? hijo.chargebeeapps__Due_Amount__c : 0;
Execute Anonymous:     Decimal duePadre = (padre != null && !ESTADOS_INVOICE_RESUELTOS.contains(padre.chargebeeapps__Status__c) && padre.chargebeeapps__Due_Amount__c != null)
Execute Anonymous:         ? padre.chargebeeapps__Due_Amount__c : 0;
Execute Anonymous: 
Execute Anonymous:     invoicesEmparejadas.add(hijo.Id);
Execute Anonymous:     if (padre != null) invoicesEmparejadas.add(padre.Id);
Execute Anonymous: 
Execute Anonymous:     PlanLPF p = new PlanLPF();
Execute Anonymous:     p.invoiceBase    = padre != null ? padre.Name : hijo.Parent_CB_Invoice_Number__c;
Execute Anonymous:     p.invoiceMulta   = hijo.Name;
Execute Anonymous:     p.invoiceBaseId  = (padre != null) ? padre.Id : null;
Execute Anonymous:     p.invoiceMultaId = hijo.Id;
Execute Anonymous:     p.invoiceDate    = (padre != null && padre.chargebeeapps__Invoice_Date__c != null) ? padre.chargebeeapps__Invoice_Date__c.date() : hijo.chargebeeapps__Invoice_Date__c.date();
Execute Anonymous:     p.montoBase      = duePadre;
Execute Anonymous:     p.montoMulta     = dueMulta;
Execute Anonymous:     p.totalAmount    = duePadre + dueMulta;
Execute Anonymous:     p.aplicaPenalty  = dueMulta > 0;
Execute Anonymous:     if (p.totalAmount > 0) planesLPF.add(p);
Execute Anonymous: }
Execute Anonymous: 
