Execute Anonymous: // ============================================================
Execute Anonymous: //  SIMULACIÓN — Cambio de ChargeBee (TC) -> ACH
Execute Anonymous: //
Execute Anonymous: //  Contrato ya tiene SM_Payment_methods__c = 'ACH' y su
Execute Anonymous: //  SM_Payment_Method__c (RecordType SM_ACH) creado por el agente
Execute Anonymous: //  comercial. Este script valida qué falta para completar la
Execute Anonymous: //  migración real, en 3 pasos (instrucción del usuario):
Execute Anonymous: //
Execute Anonymous: //   1. Cancelar en Chargebee lo pendiente: Invoice -> Request -> Subscription
Execute Anonymous: //      (en ese orden: Invoice y Request primero, Subscription al final).
Execute Anonymous: //   2. Crear el ACH Order tipo Subscription (recurrente).
Execute Anonymous: //   3. Crear un ACH Order tipo Late Payment Fee por cada ciclo de
Execute Anonymous: //      cobro que quedó sin pagar en Chargebee, emparejando cada
Execute Anonymous: //      Invoice de Late Fee ($25) con su Invoice padre vía
Execute Anonymous: //      Parent_CB_Invoice__c (campo directo en el Invoice, no hace
Execute Anonymous: //      falta pasar por CB_Charge_Request__c) -- si el padre y el
Execute Anonymous: //      hijo (multa) siguen sin pagar, el LPF de ACH suma los dos
Execute Anonymous: //      (Total_Amount__c = base + multa) y registra la multa en
Execute Anonymous: //      SM_Apply_penalty__c=true / SM_Penalty_value__c=25; si la
Execute Anonymous: //      multa ya se cobró aparte, el LPF de ACH es solo el monto
Execute Anonymous: //      base, sin penalty.
Execute Anonymous: //
Execute Anonymous: //  Después de crear los ACH Order (paso 2 y 3), se cancela Chargebee
Execute Anonymous: //  en este orden -- Invoice -> Request -> Subscription -- cada uno
Execute Anonymous: //  con la nota "Paso de TC a ACH":
Execute Anonymous: //   - Invoice: VOID vía API (Named Credential Chargebee_API), la nota
Execute Anonymous: //     va en el parámetro `comment` del POST (no existe un campo local
Execute Anonymous: //     tipo Notes en el Invoice).
Execute Anonymous: //   - Request (CB_Charge_Request__c, objeto local, no tiene API propia
Execute Anonymous: //     de Chargebee): Request_Status__c = 'Cancelled' (picklist real,
Execute Anonymous: //     doble L) + Notes__c = la nota (ese es su campo "Comment" local).
Execute Anonymous: //   - Subscription: cancel_for_items vía API, misma nota en `comment`.
Execute Anonymous: //  Cada ACH Order tipo Late Payment Fee queda con SM_Fee_CB_Invoice__c
Execute Anonymous: //  (invoice base) y SM_LPF_CB_Invoice__c (invoice de multa) poblados.
Execute Anonymous: //
Execute Anonymous: //  modoDryRun = true: SOLO lee y reporta. Cero callouts a Chargebee,
Execute Anonymous: //  cero DML. Seguro de correr las veces que haga falta para validar.
Execute Anonymous: //
Execute Anonymous: //  Autor: Carlos Lopez / Claude Code — SEPTIEMBRE 2026
Execute Anonymous: // ============================================================
Execute Anonymous: 
Execute Anonymous: Boolean modoDryRun = false;   // Autorizado por Carlos 2026-09-26 -- ejecución real contrato 00314430
Execute Anonymous: String  contractNumber = '00314430';
Execute Anonymous: 
Execute Anonymous: String  NAMED_CRED    = 'Chargebee_API';
Execute Anonymous: String  NOTA_MIGRACION = 'Paso de TC a ACH';
