Execute Anonymous:     // ACH Order tipo Subscription -- próxima fecha = próxima ocurrencia de SM_Payment_day__c en el mes.
Execute Anonymous:     Date hoy = Date.today();
Execute Anonymous:     Integer diaPago = (cont.SM_Payment_day__c != null) ? Integer.valueOf(cont.SM_Payment_day__c) : hoy.day();
Execute Anonymous:     Date proximoCobro = Date.newInstance(hoy.year(), hoy.month(), 1).addMonths(0);
Execute Anonymous:     Integer ultimoDiaMes = Date.daysInMonth(hoy.year(), hoy.month());
Execute Anonymous:     Date candidato = Date.newInstance(hoy.year(), hoy.month(), Math.min(diaPago, ultimoDiaMes));
