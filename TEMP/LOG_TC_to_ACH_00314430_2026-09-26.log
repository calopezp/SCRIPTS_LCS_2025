Execute Anonymous: // ── 2. Invoices de Chargebee (todas, para poder emparejar) ─
Execute Anonymous: Map<Id, chargebeeapps__CB_Invoice__c> invoicesById = new Map<Id, chargebeeapps__CB_Invoice__c>([
Execute Anonymous:     SELECT Id, Name, chargebeeapps__CB_Invoice_Id__c, chargebeeapps__Status__c,
Execute Anonymous:            chargebeeapps__Invoice_Date__c, chargebeeapps__Due_Amount__c, Has_Late_Fee__c,
Execute Anonymous:            Parent_CB_Invoice__c, Parent_CB_Invoice_Number__c
Execute Anonymous:     FROM   chargebeeapps__CB_Invoice__c
Execute Anonymous:     WHERE  Contract__c = :cont.Id
Execute Anonymous:     ORDER BY chargebeeapps__Invoice_Date__c ASC
Execute Anonymous: ]);
Execute Anonymous: 
Execute Anonymous: List<chargebeeapps__CB_Invoice__c> pendientes = new List<chargebeeapps__CB_Invoice__c>();
Execute Anonymous: for (chargebeeapps__CB_Invoice__c inv : invoicesById.values()) {
Execute Anonymous:     if (!ESTADOS_INVOICE_RESUELTOS.contains(inv.chargebeeapps__Status__c)) pendientes.add(inv);
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: System.debug('\n── PASO 1a. INVOICES CHARGEBEE (' + invoicesById.size() + ' total, ' + pendientes.size() + ' pendientes de VOID) ──');
Execute Anonymous: for (chargebeeapps__CB_Invoice__c inv : invoicesById.values()) {
Execute Anonymous:     Boolean esPendiente = !ESTADOS_INVOICE_RESUELTOS.contains(inv.chargebeeapps__Status__c);
Execute Anonymous:     System.debug(' ' + (esPendiente ? '⚠️ PENDIENTE' : '✓ resuelto  ') + ' — Invoice ' + inv.Name
Execute Anonymous:         + ' ▫ ' + inv.chargebeeapps__Status__c
Execute Anonymous:         + ' ▫ Fecha: ' + inv.chargebeeapps__Invoice_Date__c
Execute Anonymous:         + ' ▫ Debe: $' + inv.chargebeeapps__Due_Amount__c
Execute Anonymous:         + (inv.Has_Late_Fee__c ? ' ▫ (es Late Fee)' : ''));
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: // ── 3. Charge Requests (Late Payment Fee) de la subscription ─
Execute Anonymous: List<CB_Charge_Request__c> requests = [
Execute Anonymous:     SELECT Id, Name, Request_Status__c, Notes__c, Charge_Amount__c, Charge_Date__c,
Execute Anonymous:            CB_Invoice_Origin_Late_Fee__c, CB_Invoice_Created__c
Execute Anonymous:     FROM   CB_Charge_Request__c
Execute Anonymous:     WHERE  CB_Subscription__c = :cont.CB_Subscription__c
Execute Anonymous:     ORDER BY Charge_Date__c ASC
Execute Anonymous: ];
Execute Anonymous: 
Execute Anonymous: System.debug('\n── PASO 1b. CHARGE REQUESTS CHARGEBEE (' + requests.size() + ' total) ──');
Execute Anonymous: // Instrucción confirmada del usuario: solo se cancelan los Request "activos" -- Pending,
Execute Anonymous: // Ready To Collect, Error (todavía no se resolvieron). Los que ya están "Sent" YA fueron
Execute Anonymous: // trabajados (su invoice ya existe, se resuelve al hacer VOID del invoice) -- NO se tocan.
Execute Anonymous: Set<String> ESTADOS_REQUEST_ACTIVOS = new Set<String>{ 'Pending', 'Ready To Collect', 'Error' };
Execute Anonymous: List<CB_Charge_Request__c> requestsACancelar = new List<CB_Charge_Request__c>();
Execute Anonymous: for (CB_Charge_Request__c req : requests) {
Execute Anonymous:     Boolean esActivo = ESTADOS_REQUEST_ACTIVOS.contains(req.Request_Status__c);
Execute Anonymous:     if (esActivo) requestsACancelar.add(req);
Execute Anonymous:     System.debug(' Request ' + req.Name + ' ▫ Status actual: ' + req.Request_Status__c
Execute Anonymous:         + ' ▫ Charge: $' + req.Charge_Amount__c + ' ▫ Fecha: ' + req.Charge_Date__c
Execute Anonymous:         + (esActivo ? ' ▫ ⚠️ se cancelará' : ' ▫ ✓ ya trabajado, no se toca'));
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: // ── 4. Emparejar ciclos usando Parent_CB_Invoice__c (campo directo
Execute Anonymous: //      en el Invoice hijo de Late Fee -- NO se pasa por CB_Charge_Request__c) ──
Execute Anonymous: // Un "hijo" es un invoice con Has_Late_Fee__c=true y Parent_CB_Invoice__c poblado (la multa de $25).
Execute Anonymous: // Su "padre" es el invoice base (la cuota mensual) que la originó.
