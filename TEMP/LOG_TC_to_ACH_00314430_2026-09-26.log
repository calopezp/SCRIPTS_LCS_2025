Execute Anonymous: // ── 1. Contrato + validaciones de elegibilidad ─────────────
Execute Anonymous: Contract cont = [
Execute Anonymous:     SELECT Id, ContractNumber, Status, SM_Payment_methods__c,
Execute Anonymous:            SM_Payment_Method__c, SM_Payment_Method__r.RecordType.DeveloperName,
Execute Anonymous:            SM_Payment_Method__r.SM_ACH_Account_Number__c, SM_Payment_Method__r.ACH_Account_Type__c,
Execute Anonymous:            CB_Subscription__c, CB_Subscription__r.Name,
Execute Anonymous:            CB_Subscription__r.chargebeeapps__Subscription_status__c,
