Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     // FASE 2 — Toda la DML, ya sin callouts pendientes.
Execute Anonymous:     List<chargebeeapps__CB_Invoice__c> invoicesToUpdate = new List<chargebeeapps__CB_Invoice__c>();
Execute Anonymous:     for (chargebeeapps__CB_Invoice__c inv : pendientes) {
