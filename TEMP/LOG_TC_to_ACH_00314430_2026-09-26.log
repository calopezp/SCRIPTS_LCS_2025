Execute Anonymous:     + ' (cuenta ...' + cont.SM_Payment_Method__r.SM_ACH_Account_Number__c + ', ' + cont.SM_Payment_Method__r.ACH_Account_Type__c + ')' : 'NO ASIGNADO'));
Execute Anonymous: System.debug(' AC ya cobrado (SM_AC_collected__c): ' + cont.SM_AC_collected__c + ' ($' + cont.SM_Total_ac__c + ')');
