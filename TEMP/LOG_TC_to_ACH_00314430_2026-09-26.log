Execute Anonymous: // Orden interno OBLIGATORIO por restricción de la plataforma (mismo gotcha ya documentado
Execute Anonymous: // en CancelarContratosRunner.cls): un callout DESPUÉS de cualquier DML pendiente en la misma
Execute Anonymous: // transacción tira "System.CalloutException: You have uncommitted work pending". Por eso:
Execute Anonymous: //   FASE 1 = todos los callouts a Chargebee (cero DML antes).
Execute Anonymous: //   FASE 2 = toda la DML junta (ACH Orders, mirror local de Invoice/Subscription, Requests, Task).
Execute Anonymous: // El resultado final es el mismo que pediste (ACH creado + Chargebee cancelado, todo en el
Execute Anonymous: // mismo commit) -- el orden invoice->request->subscription solo aplica DENTRO de la Fase 1.
Execute Anonymous: if (!modoDryRun) {
Execute Anonymous: 
Execute Anonymous:     DmlLogger logger = new DmlLogger();
Execute Anonymous:     String TASK_OWNER_ID = '0051U000001MRFeQAO'; // "Legal Credit Solutions" -- mismo owner que usa CancelarContratosRunner
Execute Anonymous: 
Execute Anonymous:     // FASE 1 — Callouts a Chargebee, cero DML todavía.
Execute Anonymous:     Map<Id, Boolean> invoiceVoidOk = new Map<Id, Boolean>();
Execute Anonymous:     Boolean todosLosInvoicesOk = true;
Execute Anonymous: 
Execute Anonymous:     for (chargebeeapps__CB_Invoice__c inv : pendientes) {
Execute Anonymous:         Boolean ok = false;
Execute Anonymous:         try {
Execute Anonymous:             HttpRequest req = new HttpRequest();
Execute Anonymous:             req.setEndpoint('callout:' + NAMED_CRED + '/api/v2/invoices/'
Execute Anonymous:                 + EncodingUtil.urlEncode(inv.chargebeeapps__CB_Invoice_Id__c, 'UTF-8') + '/void');
Execute Anonymous:             req.setMethod('POST');
Execute Anonymous:             req.setHeader('Content-Type', 'application/x-www-form-urlencoded');
Execute Anonymous:             req.setBody('comment=' + EncodingUtil.urlEncode(NOTA_MIGRACION, 'UTF-8'));
Execute Anonymous:             req.setTimeout(60000);
Execute Anonymous:             HttpResponse res = new Http().send(req);
Execute Anonymous:             ok = (res.getStatusCode() == 200);
Execute Anonymous:             if (!ok) System.debug('⚠️ ERROR void Invoice ' + inv.Name + ': HTTP ' + res.getStatusCode() + ' — ' + res.getBody());
Execute Anonymous:         } catch (Exception e) {
Execute Anonymous:             System.debug('⚠️ EXCEPTION void Invoice ' + inv.Name + ': ' + e.getMessage());
Execute Anonymous:         }
Execute Anonymous:         invoiceVoidOk.put(inv.Id, ok);
Execute Anonymous:         if (!ok) todosLosInvoicesOk = false;
Execute Anonymous:     }
Execute Anonymous: 
Execute Anonymous:     Boolean subscriptionCancelOk = false;
Execute Anonymous:     if (todosLosInvoicesOk) {
Execute Anonymous:         try {
Execute Anonymous:             HttpRequest req = new HttpRequest();
Execute Anonymous:             req.setEndpoint('callout:' + NAMED_CRED + '/api/v2/subscriptions/'
