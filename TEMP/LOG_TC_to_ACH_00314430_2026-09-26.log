Execute Anonymous: class PlanLPF implements Comparable {
Execute Anonymous:     String  invoiceBase;
Execute Anonymous:     String  invoiceMulta;
Execute Anonymous:     Id      invoiceBaseId;   // -> SM_Fee_CB_Invoice__c
Execute Anonymous:     Id      invoiceMultaId;  // -> SM_LPF_CB_Invoice__c
Execute Anonymous:     Date    invoiceDate;     // fecha del invoice base -- para ordenar cronológicamente
Execute Anonymous:     Decimal montoBase;
Execute Anonymous:     Decimal montoMulta;
Execute Anonymous:     Decimal totalAmount;   // base + multa -> Total_Amount__c / SM_Total__c del ACH Order
Execute Anonymous:     Boolean aplicaPenalty; // -> SM_Apply_penalty__c
Execute Anonymous:     Date    fechaCobro;    // -> SM_Next_Transaction_Date__c (asignado después de ordenar)
Execute Anonymous:     Boolean esPTP;         // -> Is_PTP__c / SM_PTP_Montly__c
Execute Anonymous: 
Execute Anonymous:     public Integer compareTo(Object other) {
Execute Anonymous:         PlanLPF o = (PlanLPF) other;
Execute Anonymous:         if (invoiceDate == null || o.invoiceDate == null) return 0;
Execute Anonymous:         if (invoiceDate < o.invoiceDate) return -1;
Execute Anonymous:         if (invoiceDate > o.invoiceDate) return 1;
Execute Anonymous:         return 0;
Execute Anonymous:     }
Execute Anonymous: }
