<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>SM_Apply_Discount__c</field>
        <field>SM_Contract__c</field>
        <field>SM_Charge_Date__c</field>
        <field>SM_User_Who_Request_Discount__c</field>
        <field>Total_Amount__c</field>
        <field>SM_Discount_Applies_Date__c</field>
        <field>Discount_Original_Subtotal__c</field>
        <field>SM_Discount_Percentage__c</field>
        <field>SM_Discount_Reason__c</field>
        <field>SM_Discount_Status__c</field>
        <field>SM_Discount_Type__c</field>
        <field>SM_Discount_Value__c</field>
        <field>SM_Discount_Value_Afer__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <entryCriteria>
            <formula>NOT($Permission.SM_Dont_require_a_manager_to_approve_an_penalty_order)</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Send to manager</label>
        <name>Send_to_manager</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6 AND 7 AND 8</booleanFilter>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Payment_Type__c</field>
            <operation>equals</operation>
            <value>Late payment fee</value>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Apply_Discount__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Payment_Status__c</field>
            <operation>contains</operation>
            <value>Stopped</value>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Discount_Reason__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Discount_Type__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.SM_Discount_Value__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.Discount_Original_Subtotal__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>SM_ACH_Order__c.Discount_Original_Total__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Discount_ACH_Applies_Date</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_ACH_Set_Apply_Discount_to_true</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_ACH_Set_approval_status</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_ACH_Set_Subtotal</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Discount_ACH_Set_User_approve_discount</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Discount_ACH_Set_User_approve_discount</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_approval_status_to_rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_approval_status_to_pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>ACH Order: Apply Discount</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
