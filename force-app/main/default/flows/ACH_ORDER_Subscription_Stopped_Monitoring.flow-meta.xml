<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Result_Assigned</name>
        <label>Set Result Assigned</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fResultAssigned</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Stopped_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Result_Fault</name>
        <label>Set Result Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fResultFault</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Stopped_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Result_Respected</name>
        <label>Set Result Respected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varResult</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fResultRespected</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Stopped_Task</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>If_Monitoring_Needs_Assignment</name>
        <label>If Monitoring Needs Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Result_Respected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Monitored (Respect)</defaultConnectorLabel>
        <rules>
            <name>Needs_Assignment</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.SM_ContractMonitoring__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.Contract_Monitoring_By__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contract_Monitoring</targetReference>
            </connector>
            <label>Needs Assignment</label>
        </rules>
    </decisions>
    <description>Cuando una SM_ACH_Order__c tipo Subscription pasa a Stopped (cualquier usuario, por trazabilidad): activa Contract Monitoring en el contrato y asigna como responsable al usuario que detuvo la orden (si el contrato ya estaba en monitoreo con responsable, se respeta), y siempre crea una Task Open como nota historica. Desmarcar el monitoreo es manual (agente). Si la actualizacion del contrato falla (validation rule, etc.) no bloquea el Stopped: la Task se crea igual con el error.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAutomationNote</name>
        <dataType>String</dataType>
        <expression>LEFT("AUTO: ACH_ORDER_Subscription_Stopped_Monitoring - " &amp; {!$Record.Name} &amp; " STOPPED, Contract Monitoring asignado a " &amp; {!fUserName} &amp; " - " &amp; TEXT(TODAY()) &amp; IF(ISBLANK({!$Record.SM_Contract__r.SM_Id_Salesforce_LCS__c}), "", " // " &amp; {!$Record.SM_Contract__r.SM_Id_Salesforce_LCS__c}), 255)</expression>
    </formulas>
    <formulas>
        <name>fResultAssigned</name>
        <dataType>String</dataType>
        <expression>"Contract Monitoring activado. Responsable asignado: " &amp; {!fUserName} &amp; "."</expression>
    </formulas>
    <formulas>
        <name>fResultFault</name>
        <dataType>String</dataType>
        <expression>"ERROR: no se pudo activar Contract Monitoring en el contrato (revisar manualmente): " &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fResultRespected</name>
        <dataType>String</dataType>
        <expression>"El contrato ya estaba en Contract Monitoring con responsable " &amp; {!$Record.SM_Contract__r.Contract_Monitoring_By__r.FirstName} &amp; " " &amp; {!$Record.SM_Contract__r.Contract_Monitoring_By__r.LastName} &amp; "; se respeta el responsable actual."</expression>
    </formulas>
    <formulas>
        <name>fUserName</name>
        <dataType>String</dataType>
        <expression>TRIM({!$User.FirstName} &amp; " " &amp; {!$User.LastName})</expression>
    </formulas>
    <interviewLabel>ACH ORDER: Subscription Stopped Monitoring {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ACH ORDER: Subscription Stopped Monitoring</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Stopped_Task</name>
        <label>Create Stopped Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>tTaskDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Collections-Subscription Stopped</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.SM_Contract__c</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Contract_Monitoring</name>
        <label>Update Contract Monitoring</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Result_Assigned</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Result_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SM_Contract__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Contract_Monitoring_By__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SM_ContractMonitoring__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SM_Id_Salesforce_LCS__c</field>
            <value>
                <elementReference>fAutomationNote</elementReference>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_Monitoring_Needs_Assignment</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>SM_Payment_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>SM_Payment_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Stopped</stringValue>
            </value>
        </filters>
        <filters>
            <field>SM_Payment_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Subscription</stringValue>
            </value>
        </filters>
        <filters>
            <field>SM_Contract__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SM_ACH_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tTaskDescription</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Subscription {!$Record.Name} pasada a STOPPED por {!fUserName} el {!$Flow.CurrentDate}.
{!varResult}
(Nota automatica - Flow ACH_ORDER_Subscription_Stopped_Monitoring)</text>
    </textTemplates>
    <variables>
        <name>varResult</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
