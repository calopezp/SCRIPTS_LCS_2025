<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_AC_Collected_True</name>
        <label>Set AC Collected True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.SM_AC_collected__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>If_Contract_can_be_Activated</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Status_to_Activated</name>
        <label>Set Status to Activated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Evaluate_AC_Changes</name>
        <label>Evaluate AC Changes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>If_Contract_can_be_Activated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_AC_Collected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SM_Charged_AC_Amount__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Charged_AC_Amount__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SM_Total_ac__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_AC_Collected_True</targetReference>
            </connector>
            <label>Set AC Collected</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Contract_can_be_Activated</name>
        <label>If Contract can be Activated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contract_can_be_Activated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SM_AC_collected__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Payment Process</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Requires_AC_Payment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Customer_Cancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_to_Activated</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Contract can be Activated</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>CONTRACT: 05 - Before Save Orchestrator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CONTRACT: 05 - Before Save Orchestrator</label>
    <processMetadataValues>
        <name>BuilderType</name>
