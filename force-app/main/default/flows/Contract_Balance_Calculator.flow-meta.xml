    <formulas>
        <name>Formula_Calculate_Add_Month_Date</name>
        <dataType>Date</dataType>
        <expression>DATE(
YEAR({!Var_D_Period_Date}) + FLOOR( ( MONTH ({!Var_D_Period_Date}) + 1 - 1 ) / 12 ),
MOD( MONTH ({!Var_D_Period_Date}) + 1 - 1 +
IF( DAY ({!Var_D_Period_Date}) &gt; CASE( MOD( MONTH({!Var_D_Period_Date}) + 1 - 1, 12 ) + 1,
2, 28,
4, 30,
6, 30,
9, 30,
11, 30,
31 ), 1, 0 ), 12 ) + 1,
IF( DAY({!Var_D_Period_Date}) &gt; CASE( MOD( MONTH({!Var_D_Period_Date}) + 1 - 1, 12 ) + 1,
2, 28,
4, 30,
6, 30,
9, 30,
11, 30,
31 ),
1, DAY({!Var_D_Period_Date})
)
)</expression>
    </formulas>
    <formulas>
        <name>Formula_Create_Name</name>
        <dataType>String</dataType>
        <expression>&quot;INV-&quot;+{!Get_Contract.ContractNumber}+&quot;-&quot;+TEXT({!Var_I_Period_Counter})</expression>
    </formulas>
    <formulas>
        <name>Formula_Get_AC_Date</name>
        <dataType>Date</dataType>
        <expression>IF({!Var_I_Period_Counter}=1, {!Var_D_AC_Init_Date}, {!Var_D_AC_End_Date})</expression>
    </formulas>
    <formulas>
        <name>Formula_Get_Invoice_Value</name>
        <dataType>Currency</dataType>
        <expression>IF({!Var_I_Period_Counter}=1, {!Var_O_Contract.SM_Total_ac__c}, {!Var_O_Contract.SM_Net_Monthly_offer__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Formula_Get_Months_Start_To_Today</name>
        <dataType>Number</dataType>
        <expression>((YEAR(TODAY()) - YEAR({!Get_Init_Date}))*12) + (MONTH(TODAY()) - MONTH({!Get_Init_Date}))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Formula_Invoice_ID</name>
        <dataType>String</dataType>
        <expression>{!Var_O_Contract.ContractNumber}+TEXT({!Var_I_Period_Counter})</expression>
    </formulas>
    <formulas>
        <name>Formula_Period_Date_Month</name>
        <dataType>Number</dataType>
        <expression>MONTH({!Var_D_Period_Date})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Formula_Period_Date_Year</name>
