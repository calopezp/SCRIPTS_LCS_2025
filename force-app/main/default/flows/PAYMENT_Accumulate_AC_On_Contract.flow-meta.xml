<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_Contract_Eligible</name>
        <label>If Contract Eligible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Contract_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.SM_Customer_Cancellation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.Is_VIP_Contract__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.Is_Test_Contract__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.Contract_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Dependent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SM_Contract__r.CreatedDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Last_Quarter_Start_DateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contract_AC_Accumulation</targetReference>
            </connector>
            <label>Contract Eligible</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>New_Charged_AC_Amount</name>
        <dataType>Currency</dataType>
        <scale>2</scale>
        <expression>IF(ISBLANK($Record.SM_Contract__r.SM_Charged_AC_Amount__c), 0, $Record.SM_Contract__r.SM_Charged_AC_Amount__c) + $Record.SM_ACH_Order__r.SM_Total__c</expression>
    </formulas>
    <formulas>
        <name>New_Charged_AC_Fees</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>IF(ISBLANK($Record.SM_Contract__r.SM_Charged_AC_Fees__c), 0, $Record.SM_Contract__r.SM_Charged_AC_Fees__c) + 1</expression>
    </formulas>
    <formulas>
        <name>Current_Quarter_Start_Month</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>FLOOR((MONTH(TODAY())-1)/3)*3+1</expression>
    </formulas>
    <formulas>
        <name>Last_Quarter_Start_DateTime</name>
        <dataType>DateTime</dataType>
        <expression>IF(
    Current_Quarter_Start_Month - 3 &lt;= 0,
    DATETIMEVALUE(DATE(YEAR(TODAY())-1, Current_Quarter_Start_Month - 3 + 12, 1)),
    DATETIMEVALUE(DATE(YEAR(TODAY()), Current_Quarter_Start_Month - 3, 1))
)</expression>
    </formulas>
    <interviewLabel>PAYMENT: Accumulate AC On Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PAYMENT: Accumulate AC On Contract</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Contract_AC_Accumulation</name>
        <label>Update Contract AC Accumulation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SM_Contract__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SM_Charged_AC_Amount__c</field>
            <value>
                <elementReference>New_Charged_AC_Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SM_Charged_AC_Fees__c</field>
            <value>
                <elementReference>New_Charged_AC_Fees</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SM_Failed_AC_Fees__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SM_Payment_Received__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_Contract_Eligible</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Payment_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Payment_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ACCEPTED</stringValue>
            </value>
        </filters>
        <filters>
            <field>SM_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AC</stringValue>
            </value>
        </filters>
        <filters>
            <field>SM_Original_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>AC</stringValue>
            </value>
        </filters>
        <object>SM_Payment__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
