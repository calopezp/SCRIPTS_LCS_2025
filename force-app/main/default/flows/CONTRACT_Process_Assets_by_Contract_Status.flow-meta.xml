                    <stringValue>Finalized</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Assets_to_Inactivated</targetReference>
            </connector>
            <label>Set Inactivated</label>
        </rules>
    </decisions>
