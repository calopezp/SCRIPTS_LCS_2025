<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Calculate_Collection_Status</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Payment_Status__c},&apos;REJECTED&apos;,&apos;NOT COLLECTED&apos; ,&apos;ACCEPTED&apos;,&apos;COLLECTED&apos;,&apos;CANCELLED&apos;,&apos;CANCELLED&apos;,&apos;REFUNDED&apos;,&apos;NOT COLLECTED&apos;,TEXT({!$Record.Collection_Status__c}))</expression>
    </formulas>
    <interviewLabel>COLLECTIONS: Calculate Collection Status by Payment Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>COLLECTIONS: Calculate Collection Status by Payment Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Collection_Status</name>
        <label>Update Collection Status</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Collection_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>TO BE COLLECTED</stringValue>
            </value>
        </filters>
        <filters>
            <field>Collection_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PROMISE TO PAY (PTP)</stringValue>
            </value>
        </filters>
        <filters>
            <field>Collection_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>WAITING FOR PAYMENT APPROVAL</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Collection_Status__c</field>
            <value>
                <elementReference>Calculate_Collection_Status</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Collection_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Payment_Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Payment__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contract_Collection_Attempt__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
