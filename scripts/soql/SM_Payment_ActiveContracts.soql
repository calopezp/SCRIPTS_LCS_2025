SELECT Id, Name,
       SM_Contract__c, SM_Contract__r.ContractNumber, SM_Contract__r.Status,
       Payment_Status__c, SM_Type__c, SM_Original_Type__c,
       SM_Amount__c, SM_Net_Amount__c, SM_Fee_value__c, SM_Penalty_value__c,
